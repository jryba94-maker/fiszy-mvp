# Local Development template. Copy custom values to .env.development.local;
# `vercel env pull` may replace .env.local. Never commit either local file.
# Use Development Redis and Stripe Test Mode only on a developer computer.

# Vercel injects VERCEL_ENV in hosted deployments. Set it manually only locally.
# This value also namespaces Redis keys as fiszy:development:*.
VERCEL_ENV=development

# Public canonical URL used by metadata, sitemap and social sharing cards.
# Set the final HTTPS domain independently in Preview and Production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Lock Checkout return URLs to exact local origins.
FISZY_DEFAULT_CHECKOUT_ORIGIN=http://127.0.0.1:3000
FISZY_ALLOWED_CHECKOUT_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# SHA-256 of the exact Development Redis REST URL. Required only by the
# controlled integration tests; it prevents them from mutating another store.
FISZY_RACE_TEST_REDIS_URL_SHA256=

# Production safety: set FISZY_DEFAULT_CHECKOUT_ORIGIN explicitly to the
# canonical HTTPS domain. Production Checkout is blocked without it.

# Redis REST storage. Keep URL and token from the same Development resource.
# Accepted aliases are documented in README; configure only one matching pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stripe Test Mode locally (`sk_test_...`). The webhook secret must belong to
# the currently running local Stripe listener (`whsec_...`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Keep stripe until Autopay merchant onboarding, sandbox acceptance and live
# verification are complete. Przelewy24 remains an inactive adapter placeholder.
FISZY_PAYMENT_PROVIDER=stripe
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
P24_SANDBOX=true

# Unique random admin secret, minimum 32 characters. Use a different secret in
# every environment. It is server-only and must never use a NEXT_PUBLIC_ prefix.
FISZY_ADMIN_SECRET=
# Role for the shared admin session: owner, operator, support or viewer.
# Keep owner until individual staff identities replace the shared secret.
FISZY_ADMIN_ROLE=owner
# JSON object mapping Clerk user IDs to individual roles. Example only:
# {"user_abc":"owner","user_def":"support"}
FISZY_ADMIN_USERS_JSON=

# Dedicated HMAC salt for privacy-preserving public rate-limit keys. Use at
# least 32 random bytes and a different value in every environment.
FISZY_RATE_LIMIT_SECRET=
# Clerk authentication (provisioned through the Vercel Marketplace; never commit real values)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional locally, required for Production transactional messages. Configure
# only after verifying the sending domain in Resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FISZY_EMAIL_FROM=Fiszy <powiadomienia@fiszy.pl>
FISZY_ALERT_EMAIL=rodo@fiszy.pl

# Vercel Cron authenticates the daily Production health check with this
# server-only value. Use a separate random secret in every environment.
CRON_SECRET=

# Autopay: obtain these through the merchant panel, never commit real keys.
AUTOPAY_ENVIRONMENT=sandbox
AUTOPAY_SERVICE_ID=
AUTOPAY_SHARED_KEY=
AUTOPAY_HASH_ALGORITHM=sha256
# Exact payment-start URL assigned by Autopay, matching sandbox/live host.
AUTOPAY_START_URL=
# Merchant-assigned hosted BLIK channel only; never guess an ID or enable BNPL.
AUTOPAY_FAST_GATEWAY_ID=
# Set true ONLY after provider confirms OrderID reuse is blocked and tested.
AUTOPAY_ORDER_REUSE_BLOCKED=false
# Set true ONLY after real end-to-end sandbox and live acceptance tests.
AUTOPAY_INTEGRATION_VERIFIED=false

# Actual seller identity, consistent with Autopay onboarding. NIP is optional
# only when the seller legitimately has none; do not invent one.
FISZY_SELLER_NAME=Jakub Ryba
FISZY_SELLER_ADDRESS=
FISZY_RETURN_ADDRESS=
FISZY_CONTACT_EMAIL=kontakt@fiszy.pl
FISZY_CONTACT_PHONE=
FISZY_SELLER_NIP=
