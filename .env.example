# Copy this file to .env.local and use development or test credentials only.
# Never place production credentials in a local environment file.

# Keep local Redis records isolated from Preview and Production.
VERCEL_ENV=development

# Explicitly lock local Checkout return URLs and destructive race tests.
FISZY_DEFAULT_CHECKOUT_ORIGIN=http://127.0.0.1:3000
FISZY_ALLOWED_CHECKOUT_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
FISZY_RACE_TEST_REDIS_URL_SHA256=

# Redis REST storage (recommended variable names)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local admin access
FISZY_ADMIN_SECRET=
